<div class="results-list results-list-small" style="display: none;">
  {% for item in resultItems %}
  <a href="{{ item.url }}">
    <div class="results-list__item-detail">
      <p class="results-list__item-date">{{ item.formattedDate }}</p>
      <p class="results-list__item-type">{{ item.courseType | courseTypeAbbr }}</p>
      <h3 class="results-list__item-title">{{ item.title }}</h3>
      {% if not item.virtual %}
      <p class="results-list__item-location">{{ item.venueCity }}, {{ item.venueState }}</p>
      {% endif %}
      {% if item.classification and item.classification != "Not Sanctioned" and item.classification != "Pending" %}
      <p class="results-list__item-status sanctioned">{{ item.classification }}</p>
      {% endif %}
    </div>
  </a>
  {% endfor %}
</div>
