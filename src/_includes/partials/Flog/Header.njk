{# The FLOG mockup's header: the page's name, whose log it is (app.js fills
   it from the persona), Log a swim, and FLOG's own nav. Links use
   flogRoot; snapshots rewrite it. #}
<header class="flog-head">
  <div class="flog-head__text">
    <h1 class="flog-head__title">{{ flogHeading }}</h1>
    <p class="flog-head__who" data-flog-who></p>
  </div>
  {% if flogPage != "log-swim" %}
  <a class="flog-btn flog-btn--primary flog-head__log" href="{{ flogRoot }}log-swim/"><svg class="flog-icon" aria-hidden="true" focusable="false"><use href="#flog-i-plus"></use></svg>Log a swim</a>
  {% endif %}
</header>
<nav class="flog-nav" aria-label="Fitness Log">
  <a class="flog-nav__link" href="{{ flogRoot }}"{% if flogPage == "home" %} aria-current="page"{% endif %}><svg class="flog-icon" aria-hidden="true" focusable="false"><use href="#flog-i-calendar"></use></svg>Calendar</a>
  <a class="flog-nav__link" href="{{ flogRoot }}totals/"{% if flogPage == "totals" %} aria-current="page"{% endif %}><svg class="flog-icon" aria-hidden="true" focusable="false"><use href="#flog-i-chart"></use></svg>Totals</a>
  <a class="flog-nav__link" href="{{ flogRoot }}preferences/"{% if flogPage == "preferences" %} aria-current="page"{% endif %}><svg class="flog-icon" aria-hidden="true" focusable="false"><use href="#flog-i-sliders"></use></svg>Preferences</a>
</nav>
