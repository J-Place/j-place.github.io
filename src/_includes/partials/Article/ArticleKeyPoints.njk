<!-- No production analog: searched production/ for keypoint/key-point/takeaway with no hits.
     Styled to match .article-author.bg-ltblue's existing tinted/bordered callout-box language
     (see ArticleAboutAuthor.njk) rather than inventing a new visual language. -->
<div class="key-points bg-ltblue include-in-nav">
  <h2 class="key-points__title">{{ keyPointsTitle | default("Key Points") }}</h2>
  <ul class="key-points__list">
    {% for point in keyPoints %}
    <li>{{ point | safe }}</li>
    {% endfor %}
  </ul>
</div>
