{# Your Swim (Pace and calories: on Training Tools since 2026-10-27, after
   Race Analysis' Calculators from 2026-10-25 and Training Metrics before
   that): one swim in, and its Calorie Burn and Training Pace out (Pace
   Conversion is retired). Filled and read by swim-tools-v2.js. #}
{% from "partials/SwimToolsV2/TimeField.njk" import timeField %}
{% from "partials/SwimToolsV2/StrokeSelect.njk" import strokeSelect %}
<div class="swim-panel swim-swim" id="your-swim" aria-labelledby="your-swim-title">
  {# Inputs, on light blue #}
  <div class="swim-panel__band swim-panel__band--blue">
    <div class="swim-swim__fields">
      {# Any distance; the arrows step through multiples of 25 #}
      <div class="swim-swim__field">
        <label class="swim-swim__label" for="sd-metrics-distance-number">Distance <span class="swim-swim__optional" data-st="metricsDistanceUnit">(yards)</span></label>
        <input type="number" inputmode="numeric" min="25" step="25" class="form-control swim-params__number" id="sd-metrics-distance-number" data-metric-input="distance">
      </div>
      {# Optional: "Any" is a mixed workout #}
      <div class="swim-swim__field">
        <span class="swim-swim__label" id="sd-metrics-stroke-label">Stroke <span class="swim-swim__optional">(optional)</span></span>
        {{ strokeSelect('aria-labelledby="sd-metrics-stroke-label"', 'data-metric-input="stroke"', true) }}
      </div>
      {# The course swum: sets the unit, and which course Pace Conversion converts from #}
      <div class="swim-swim__field">
        <span class="swim-swim__label" id="sd-metrics-course-label">Course</span>
        <div class="swim-seg" role="group" aria-labelledby="sd-metrics-course-label" data-metric="course">
          {% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ c }}</button>{% endfor %}
        </div>
      </div>
      <div class="swim-swim__field">
        <span class="swim-swim__label" id="sd-metrics-time-label">Time</span>
        {{ timeField("sd-metrics-time-label", 'data-time-metric="time"', "xs") }}
      </div>
      {# How hard the swim felt, 1 to 10 (optional): a slider on a track shaded
         light blue to red. Faded with no thumb until rated; clicking
         or dragging anywhere on it rates, arrows step, the mouse wheel steps
         it while it's focused, and × clears. Its word shows in the label.
         Adjusts Calorie Burn, and saved with Add to Log (swim-tools-v2.js). #}
      <div class="swim-swim__field swim-felt">
        <label class="swim-swim__label" for="sd-metrics-effort">Intensity <span class="swim-swim__optional" data-st="effortWord"></span></label>
        <div class="swim-slider is-unrated" data-effort-slider>
          <span class="swim-slider__end" aria-hidden="true">1</span>
          <input type="range" min="1" max="10" step="1" value="5" class="swim-slider__input" id="sd-metrics-effort" data-effort-range>
          <span class="swim-slider__end" aria-hidden="true">10</span>
          <button type="button" class="swim-slider__clear" data-effort-clear aria-label="Clear intensity" hidden><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </div>
      </div>
      {# Retired 2026-10-15: View Log (production's /myusms/flog/) and Add to
         Log (an outline button, data-modal-target="#swimDeckLog", opening
         the Add to Log modal in Editors.njk), in a .swim-swim__log pair
         here. Their CSS is commented out in swim-tools-v2.css. #}
    </div>
    <p class="swim-card__sub swim-swim__hint" data-st="metricsHint" aria-live="polite"></p>
  </div>
  {# The results, from the swim above, on white #}
  <div class="swim-panel__band">
    <div class="swim-deck__kpis">
      <div class="swim-kpi swim-kpi--narrow">
        <span class="swim-kpi__label"><i class="fa-solid fa-fire swim-kpi__icon--calories" aria-hidden="true"></i>Calorie burn</span>
        {# What the estimate allows for, whichever is set: "Butterfly @ 5/10",
           "@ 5/10" or "Butterfly" #}
        <span class="swim-kpi__sub swim-cal__note" data-st="calNote"></span>
        <span class="swim-kpi__value"><span data-st="calValue"></span><span class="swim-kpi__unit">cal</span></span>
      </div>
      <div class="swim-kpi swim-kpi--narrow">
        <span class="swim-kpi__label"><i class="fa-solid fa-stopwatch swim-kpi__icon--pace" aria-hidden="true"></i>Training pace</span>
        <span class="swim-kpi__value swim-kpi__value--lg"><span data-st="paceValue"></span><span class="swim-kpi__unit" data-st="paceUnit"></span></span>
      </div>
      {# Retired 2026-10-13: Pace Conversion (PaceConversion.njk, kept for reuse).
         To restore, include it here again; renderMetrics still fills it. #}
      {# Workout Library, Training Plans and Send to Strava moved to Training
         Metrics 2026-10-25 (Training.njk), as did Training Effect (via
         Highlights) #}
    </div>
  </div>
</div>
