{# Time Predictions, as v4's: your bests in Your Event's course and
   stroke against your age group's USMS rankings (the Top Times files under
   /data/top-times/, fetched as needed; docs/api/top-times.openapi.yaml), with
   projected times where you haven't raced. Drawn by swim-tools-v2.js. #}
{% from "partials/SwimToolsV2/SectionGear.njk" import sectionGear %}
<article class="swim-card" id="race-predictor">
  <header class="swim-card__header">
    <div class="swim-card__heading">
      <h3 class="swim-card__title swim-card__title--icon"><svg class="swim-card__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M10 2h4"/></svg>Time Predictions
        {# Chart or table: a small text link inline after the title #}
        <button type="button" class="swim-pred-link swim-pred-view" data-pred-view>Table view</button>
        {# Add races (the Your Races modal, data-races-target="pred") removed
           2026-10-16; the selection code in swim-tools-v2.js stays, unused
           here, for Race History #}</h3>
      <p class="swim-card__sub" data-st="predSubtitle"></p>
    </div>
    {# Add a race (+, #swimDeckRace): retired 2026-10-14, see Editors.njk #}
    {{ sectionGear("swimDeckPlan", "Race Metrics") }}
  </header>
  {# A selection from the Your Races modal showing: how many, and Clear #}
  <p class="swim-picked" data-picked-note="pred" hidden><span data-picked-text></span> <button type="button" class="swim-pred-link swim-picked__clear" data-picked-clear="pred">Clear</button></p>

  <div data-view-panel="chart">
    {# The events, along the top: "200Fr" #}
    <div class="swim-pred__axis" data-pred-axis></div>
    {# Pace per 100, slower higher, from 15 s below your shortest event #}
    <div class="swim-pred-frame">
      <div class="swim-pred__yaxis" data-pred-y aria-hidden="true"></div>
      <div class="swim-pred">
        {# Skeleton while the rankings load: a shimmer behind the plot, so your
           own dots still show over it (.is-loading, swim-tools-v2.js) #}
        <div class="swim-skel swim-pred__skel" aria-hidden="true"></div>
        <svg class="swim-pred__svg" viewBox="0 0 100 100" preserveAspectRatio="none" role="img" data-pred-svg>
          {# 3% black from the age group's slowest line down to the chart's bottom #}
          <polygon points="" class="swim-pred__field" data-pred-field></polygon>
          {# 5% black between the median line and the top ten line #}
          <polygon points="" class="swim-pred__field swim-pred__field--mid" data-pred-field-mid></polygon>
          {# 8% black from 10th place down: the Top 10 zone #}
          <polygon points="" class="swim-pred__field swim-pred__field--top10" data-pred-field-top></polygon>
          {# White from the fastest line down: nobody in the age group swims faster #}
          <polygon points="" class="swim-pred__field swim-pred__field--clear" data-pred-field-fastest></polygon>
          <line x1="0" y1="100" x2="100" y2="100" class="swim-pred__base"></line>
          {# The age group's slowest swims, outliers dropped #}
          <polyline points="" class="swim-pred__line swim-pred__line--bottom" data-pred-bottom></polyline>
          {# 10th place at each distance #}
          <polyline points="" class="swim-pred__line swim-pred__line--top10" data-pred-top10></polyline>
          {# The fastest ranked swim (1st place) #}
          <polyline points="" class="swim-pred__line swim-pred__line--fastest" data-pred-fastest></polyline>
          <polyline points="" class="swim-pred__line swim-pred__line--group" data-pred-group></polyline>
          {# Your bests joined to the projected times, dotted #}
          <polyline points="" class="swim-pred__line swim-pred__line--proj" data-pred-proj></polyline>
          <path d="" class="swim-pred__line" data-pred-you></path>
        </svg>
        <div data-pred-dots></div>
      </div>
    </div>
  </div>

  <div data-view-panel="table" hidden>
    <div class="swim-table-wrap">
      <table class="swim-table swim-pred-table">
        <thead><tr><th scope="col">Event</th><th scope="col">Your best</th><th scope="col">Per 100</th><th scope="col" data-st="groupCol">Age-group median</th><th scope="col">Per 100</th><th scope="col" data-st="bottomCol">Age-group slowest</th><th scope="col">Per 100</th><th scope="col" data-st="topTenCol">Age-group top ten</th><th scope="col">Per 100</th><th scope="col" data-st="fastestCol">Age-group fastest</th><th scope="col">Per 100</th></tr></thead>
        <tbody data-pred-rows></tbody>
      </table>
    </div>
  </div>

  {# Shown when you'd have won a distance outright #}
  <p class="swim-pred-win-note" data-pred-win-note aria-live="polite" hidden></p>
  <div class="swim-pred-insight" data-pred-insight></div>
  {# Each pill turns a line off and on #}
  <div class="swim-pred-legend" role="group" aria-label="Show or hide a line" data-pred-legend></div>
</article>
