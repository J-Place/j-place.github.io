{# The Convert a Time entry at Your age (in the controls above), converted to other
   age groups. Rows are filled by swim-tools-v2.js. #}
<article class="swim-card" id="age-conversion">
  <header class="swim-card__header">
    <div class="swim-card__heading">
      <h3 class="swim-card__title">Age Group Conversion</h3>
      <p class="swim-card__sub" data-st="ageSubtitle"></p>
    </div>
  </header>
  {# Until there's a time to convert, a prompt in red over the empty rows
     (swim-tools-v2.js) #}
  <div class="swim-ages__wrap">
    <ol class="swim-ages" data-st-age-rows></ol>
    <p class="swim-ages__prompt" data-st-age-prompt aria-live="polite" hidden></p>
  </div>
  <p class="swim-card__note">Younger groups estimate what you might have swum then; older groups show what to expect.</p>
</article>
