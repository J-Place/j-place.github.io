{# The Dashboard section (members only), first of the sections on Home: its
   summary band, one card from each section that leads into it (since
   2026-10-25): your training this week (Training Metrics), your goal in
   Your Event (Race Metrics), and one of the age-up and comeback cards (as
   v4's engagement cards): age-up when you move up within a year, else
   comeback. Filled by swim-tools-v2.js (renderSummary, renderWeek). #}
{# Upcoming pool meets and virtual events, for the race card #}
{% set meets = [] %}
{% for e in eventsEnriched %}{% if e.courseType in ['SCY', 'SCM', 'LCM'] or e.virtual %}{% set _ = meets.push({ title: e.title, url: e.url, date: e.startDate, course: e.courseType, state: e.venueState, virtual: e.virtual }) %}{% endif %}{% endfor %}

<section class="swim-deck__section swim-dashboard" id="dashboard" aria-labelledby="dashboard-title">
<h2 class="swim-deck__eyebrow" id="dashboard-title">Highlights</h2>
{# Inside the section, so the Dashboard is the sections' first child #}
<script type="application/json" id="meets-data">{{ meets | dump | safe }}</script>
<div class="swim-summary">
  {# Your training this week (since 2026-10-25), a compact card from
     Training Metrics: the status, the last 7 days' yards and swims, and
     the latest swim's Training Effect, then a link to the section
     (swim-tools-v2.js, renderWeek) #}
  <article class="swim-card swim-summary__card swim-week">
    <div class="swim-summary__heading">
      <h3 class="swim-summary__title">Your Training</h3>
      <p class="swim-summary__lead" data-st="weekTitle"></p>
    </div>
    <div class="swim-week__figures" data-week-figures>
      <div><div class="swim-goal__label">Last 7 days</div><div class="swim-goal__value"><span data-st="weekYards"></span><span class="swim-goal__unit" data-st="weekUnit"></span></div></div>
      <div><div class="swim-goal__label">Swims</div><div class="swim-goal__value" data-st="weekSwims"></div></div>
      <div data-week-effect><div class="swim-goal__label">Latest swim</div><div class="swim-goal__value"><span data-st="weekEffect"></span><span class="swim-goal__unit" data-st="weekEffectWord"></span></div></div>
    </div>
    <p class="swim-summary__text" data-st="weekText"></p>
    <div class="swim-summary__links">
      <button type="button" class="swim-summary__arrow-link" data-show-section="training-metrics">See your training <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
      <a href="#swimDeckLog" data-modal-target="#swimDeckLog">Add to Log</a>
    </div>
  </article>


  <article class="swim-card swim-summary__card swim-summary__card--wide swim-goal">
    <div class="swim-goal__head">
      <div class="swim-summary__heading">
        <h3 class="swim-summary__title">Race Goal</h3>
        <p class="swim-summary__lead" data-st="goalTitle"></p>
        <p class="swim-summary__fine" data-st="goalSuggestion" hidden></p>
      </div>
      <span class="swim-summary__meta"><a href="#swimDeckPlan" data-goal-change data-modal-target="#swimDeckPlan">Set this goal</a></span>
    </div>
    <div class="swim-goal__stats">
      <div><div class="swim-goal__label">Latest<span class="swim-goal__date" data-st="goalLatestDate"></span></div><div class="swim-goal__value swim-goal__value--latest" data-st="goalLatest">—</div></div>
      <div><div class="swim-goal__label">Best<span class="swim-goal__date" data-st="goalBestDate"></span></div><div class="swim-goal__value" data-st="goalBest">—</div></div>
      <div><div class="swim-goal__label" data-st="goalTimeLabel">Goal</div><div class="swim-goal__value swim-goal__value--goal" data-st="goalTime">—</div></div>
      <div><div class="swim-goal__label">To go</div><div class="swim-goal__value" data-goal-to-go><span data-st="goalToGo">—</span><span class="swim-goal__unit"> s</span></div></div>
    </div>
    {# Slower on the left: the filled bar is your latest, the triangle your best, the yellow dot your goal; until you set one, a grey open circle is the suggested goal #}
    {# The track's slowest and fastest times at its ends, beside the bar #}
    <div class="swim-track" data-goal-track>
      <span class="swim-track__end" data-st="goalTrackHi"></span>
      <div class="swim-track__bar" role="img" data-goal-track-bar>
        <span class="swim-track__rail"></span>
        <span class="swim-track__fill" data-goal-track-fill></span>
        {# Both slide to change the goal (swim-tools-v2.js, goalDrag) #}
        <span class="swim-track__goal" data-goal-track-goal data-goal-drag="track" tabindex="0" role="slider" aria-label="Goal time" title="Drag to change your goal"></span>
        <span class="swim-track__suggested" data-goal-track-suggested data-goal-drag="track" tabindex="0" role="slider" aria-label="Suggested goal time" title="Drag to set your goal"></span>
        <span class="swim-track__best" data-goal-track-best></span>
        <span class="swim-track__latest" data-goal-track-latest></span>
      </div>
      <span class="swim-track__end" data-st="goalTrackLo"></span>
      {# Each mark's name under it (swim-tools-v2.js places them) #}
      <div class="swim-track__names" aria-hidden="true">
        <span class="swim-track__name" data-goal-track-name="latest">Latest</span>
        <span class="swim-track__name" data-goal-track-name="best">Best</span>
        <span class="swim-track__name" data-goal-track-name="goal">Goal</span>
      </div>
    </div>
    {# What the goal means against your times, once one's set (swim-tools-v2.js) #}
    <p class="swim-summary__text swim-goal__synopsis" data-st="goalSynopsis" hidden></p>
    <div class="swim-goal__actions">
      <a href="#race-splits" class="btn btn-primary">Practice at goal pace</a>
      <button type="button" class="btn btn-outline" data-goal-share>Share progress card</button>
    </div>
    <p class="swim-goal__share-note" data-st="goalShareNote" aria-live="polite"></p>
  </article>

  <article class="swim-card swim-summary__card swim-ageup" data-summary-fallback>
    <h3 class="swim-summary__title" data-st="ageUpTitle">Your age group</h3>
    <p class="swim-summary__text" data-st="ageUpText"></p>
    <p class="swim-summary__text swim-summary__short" data-st="ageUpShort"></p>
    <div class="swim-gaps" data-ageup-gaps></div>
    <p class="swim-summary__fine" data-st="ageUpFine"></p>
  </article>

  <article class="swim-card swim-summary__card swim-comeback" data-summary-fallback>
    <h3 class="swim-summary__title" data-st="sinceTitle">Find your next race</h3>
    <p class="swim-summary__text" data-st="sinceText"></p>
    <div class="swim-meets" data-comeback-meets></div>
    <div class="swim-summary__links">
      <a href="/events/index.html" class="swim-summary__arrow-link">See meets near you <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      <a href="#swimDeckRace" data-modal-target="#swimDeckRace" class="swim-summary__full-only">Add a race</a>
    </div>
  </article>
</div>
</section>
