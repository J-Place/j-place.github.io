{# Your race history, newest race date first (Add a Race modal): the newest
   few, or all of them with Show all; filterable by stroke and distance. The
   Race Time Predictor is built from all of them. Filled by
   swim-tools-v2.js. #}
{# Each persona's races from src/_data/raceHistory.json, plus the page's
   default persona; swim-tools-v2.js picks the active one (?user=) #}
<script type="application/json" id="race-history-data">{{ { "default": swimmerId, "swimmers": raceHistory.swimmers } | dump | safe }}</script>
<div class="swim-card swim-races" id="race-history">
  <header class="swim-card__header">
    <div class="swim-card__heading">
      <h3 class="swim-card__title">Your Races</h3>
      <p class="swim-card__sub" data-st="racesCount"></p>
    </div>
    {# Filters: a stroke, and a distance from the ones you've raced in it
       (swim-tools-v2.js). Races are added from the predictor's + button. #}
    <div class="swim-races__filters">
      <select class="form-control" aria-label="Stroke" data-input="racesStroke">
        <option value="">All strokes</option>
        {% for s in [["Free", "Free"], ["Breast", "Breast"], ["Back", "Back"], ["Fly", "Butterfly"], ["IM", "IM"]] %}<option value="{{ s[0] }}">{{ s[1] }}</option>{% endfor %}
      </select>
      <select class="form-control" aria-label="Distance" data-input="racesDistance" data-st-races-distances>
        <option value="">All distances</option>
      </select>
    </div>
  </header>
  <ol class="swim-races__list" id="swim-races-list" data-st-races></ol>
  <button type="button" class="swim-races__toggle" data-races-toggle aria-controls="swim-races-list" aria-expanded="false" hidden></button>
</div>
