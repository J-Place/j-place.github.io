<article class="swim-card" id="race-splits">
  <header class="swim-card__header">
    <div class="swim-card__heading">
      <h3 class="swim-card__title">Race Splits</h3>
      <p class="swim-card__sub" data-st="splitsSubtitle"></p>
    </div>
  </header>
  <div class="swim-seg swim-seg--block" role="group" aria-label="Strategy" data-control="strategy">
    <button type="button" data-value="even" aria-pressed="true">Even</button><button type="button" data-value="fast" aria-pressed="false">Fast start</button><button type="button" data-value="neg" aria-pressed="false">Negative</button>
  </div>
  {# Filled by swim-tools-v2.js #}
  <div class="swim-splits__bar" aria-hidden="true" data-st-split-bar></div>
  {# Scrolls inside the card for long races (a 1650 by 50s is 33 rows) #}
  <ol class="swim-splits" data-st-split-rows tabindex="0" aria-label="Splits"></ol>
</article>
