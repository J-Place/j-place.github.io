{# Hidden for now (since 2026-10-27; Your Strengths takes its place): it
   still renders, unseen. To restore, drop the hidden attribute. #}
{% from "partials/SwimToolsV2/SectionGear.njk" import sectionGear %}
<article class="swim-card" id="race-splits" hidden>
  <header class="swim-card__header">
    <div class="swim-card__heading">
      <h3 class="swim-card__title">Race Splits</h3>
      <p class="swim-card__sub" data-st="splitsSubtitle"></p>
    </div>
    {{ sectionGear("swimDeckPlan", "Race Metrics") }}
  </header>
  <div class="swim-seg swim-seg--block" role="group" aria-label="Strategy" data-control="strategy">
    <button type="button" data-value="even" aria-pressed="true">Even</button><button type="button" data-value="fast" aria-pressed="false">Fast start</button><button type="button" data-value="neg" aria-pressed="false">Negative</button>
  </div>
  {# Filled by swim-tools-v2.js #}
  <div class="swim-splits__bar" aria-hidden="true" data-st-split-bar></div>
  {# Scrolls inside the card for long races (a 1650 by 50s is 33 rows) #}
  <ol class="swim-splits" data-st-split-rows tabindex="0" aria-label="Splits"></ol>
  {# Practice the race pace in pieces, as v4's Race Splits (swim-tools-v2.js) #}
  <div class="swim-practice">
    <div class="swim-practice__label">Practice:</div>
    <div class="swim-practice__set" data-st="practiceSet"></div>
    <div class="swim-practice__note" data-st="practiceNote"></div>
    <div class="swim-practice__links">
      <a href="#0"><i class="fa-solid fa-book-open" aria-hidden="true"></i>Find sets in Workout Library</a>
      <a href="#swimDeckLog" data-modal-target="#swimDeckLog"><i class="fa-solid fa-circle-plus" aria-hidden="true"></i>Add to my log</a>
    </div>
  </div>
</article>
