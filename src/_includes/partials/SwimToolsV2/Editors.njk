{# Modals for Swim Tools v2 (swim-tools-v2.js) #}
{% from "partials/SwimToolsV2/TimeField.njk" import timeField %}
{% from "partials/SwimToolsV2/StrokeSelect.njk" import strokeSelect %}
{% set modalModifier = "swim-deck-modal" %}

{# Add a race to your race history (the Your Races card), which the Race
   Time Predictor is built from. Starts from Your Event each time it opens.
   Adds on the button, not as you type. Opened from the "add a race" link in
   Time Predictions' summary (its + button is retired). #}
{% set modalId = "swimDeckRace" %}
{% set modalTitle = "Add a Race" %}
{% set modalBody %}
<div class="swim-deck-modal__row swim-deck-modal__row--compact">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-race-distance-label">Distance</span>
    <div class="swim-deck__field">
      <select class="form-control" id="sd-race-distance" aria-labelledby="sd-race-distance-label" data-race-input="distance" data-st-race-options></select>
      <span class="swim-deck__field-value" aria-hidden="true" data-st="raceDistance"></span>
    </div>
  </div>
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-race-stroke-label">Stroke</span>
    {{ strokeSelect('aria-labelledby="sd-race-stroke-label"', 'data-race-input="stroke"') }}
  </div>
</div>
<div class="form-group">
  <span class="swim-deck-modal__label" id="sd-race-course-label">Course</span>
  <div class="swim-seg" role="group" aria-labelledby="sd-race-course-label" data-race="course">
    {% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ c }}</button>{% endfor %}
  </div>
</div>
<div class="swim-deck-modal__row swim-deck-modal__row--compact">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-race-time-label">Time</span>
    {{ timeField("sd-race-time-label", 'data-time-race="time"', "sm") }}
  </div>
  <div class="form-group">
    <label for="sd-race-date">Date</label>
    <input type="date" class="form-control swim-params__date" id="sd-race-date" data-race-input="date" required>
  </div>
</div>
<span class="swim-params__hint" data-st="raceHint" aria-live="polite"></span>
{% endset %}
{% set modalFooter %}
<button type="button" class="btn btn-md btn-outline js-modal-close">Cancel</button>
<button type="button" class="btn btn-md btn-primary" data-add-race>Add Race</button>
{% endset %}
{% include "components/modal.njk" %}

{# Add to Log (from Training Metrics and Highlights' Your Training card):
   a swim you did, its own fields, not the calculators' (since 2026-10-25;
   it was the Your Swim workout as it stood). Starts empty and dated today
   each time it opens; saved in the browser (swim-tools-v2.js). #}
{% set modalId = "swimDeckLog" %}
{% set modalTitle = "Add to Log" %}
{% set modalBody %}
<div class="swim-deck-modal__row swim-deck-modal__row--compact">
  <div class="form-group">
    <label for="sd-log-date">Date</label>
    <input type="date" class="form-control swim-params__date" id="sd-log-date" data-log-input="date" required>
  </div>
  <div class="form-group">
    <label for="sd-log-distance">Distance <span class="swim-swim__optional" data-st="logUnit">(yards)</span></label>
    <input type="number" inputmode="numeric" min="25" step="25" class="form-control swim-params__number" id="sd-log-distance" data-log-input="distance">
  </div>
</div>
<div class="form-group">
  <span class="swim-deck-modal__label" id="sd-log-course-label">Course</span>
  <div class="swim-seg" role="group" aria-labelledby="sd-log-course-label" data-log="course">
    {% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ c }}</button>{% endfor %}
  </div>
</div>
<div class="swim-deck-modal__row swim-deck-modal__row--compact">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-log-time-label">Time</span>
    {{ timeField("sd-log-time-label", 'data-time-log="time"', "sm") }}
  </div>
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-log-stroke-label">Stroke <span class="swim-swim__optional">(optional)</span></span>
    {{ strokeSelect('aria-labelledby="sd-log-stroke-label"', 'data-log-input="stroke"', true) }}
  </div>
</div>
{# How hard it felt, 1 to 10 (optional): shown beside its Training Effect #}
<div class="form-group">
  <label for="sd-log-effort">Intensity <span class="swim-swim__optional">(optional)</span></label>
  <div class="swim-deck__field swim-deck__field--effort">
    <select class="form-control" id="sd-log-effort" data-log-input="effort">
      <option value="">Not rated</option>
      {% for n in range(1, 11) %}<option value="{{ n }}">{{ n }}</option>{% endfor %}
    </select>
    <span class="swim-deck__field-value" aria-hidden="true" data-st="logEffort">Not rated</span>
  </div>
</div>
<span class="swim-params__hint swim-log__hint" data-st="logHint" aria-live="polite"></span>
{% endset %}
{% set modalFooter %}
<button type="button" class="btn btn-md btn-outline js-modal-close">Cancel</button>
<button type="button" class="btn btn-md btn-primary" data-save-log>Save to Log</button>
{% endset %}
{% include "components/modal.njk" %}

{# A guest's age group and competition category, from Age Group
   Conversion's prompt: the same as the header's Age Group and Competition
   Category, applied on Confirm (swim-tools-v2.js). #}
{% set modalId = "swimDeckWho" %}
{% set modalTitle = "Swimmer Info" %}
{% set modalBody %}
<div class="swim-deck-modal__row swim-deck-modal__row--compact swim-who">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-who-age-label">Age Group</span>
    <div class="swim-deck__field">
      <select class="form-control" id="sd-who-age" aria-labelledby="sd-who-age-label" data-who-age>
        <option value="">Select</option>
        {% for g in ageGroups %}<option value="{{ g[0] }}">{{ g[1] }}</option>{% endfor %}
      </select>
      <span class="swim-deck__field-value" aria-hidden="true" data-st="whoAge">Select</span>
    </div>
  </div>
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-who-sex-label">Competition Category</span>
    <div class="swim-seg" role="group" aria-labelledby="sd-who-sex-label" data-who-sex>
      <button type="button" data-value="Men" aria-pressed="false">Men's/Open</button><button type="button" data-value="Women" aria-pressed="false">Women's</button>
    </div>
  </div>
</div>
{% endset %}
{% set modalFooter %}
<button type="button" class="btn btn-md btn-outline js-modal-close">Cancel</button>
<button type="button" class="btn btn-md btn-primary" data-who-set disabled>Confirm</button>
{% endset %}
{% include "components/modal.njk" %}

{# Race Metrics' controls as a modal: Your Event (distance, stroke,
   course; its goal too until 2026-10-27, when the goal moved to the Race
   Goal card alone). The same settings as the section's own controls,
   bound the same way, so the two always match and a change in either
   applies at once (swim-tools-v2.js). No trigger yet: open it with
   data-modal-target="#swimDeckPlan". #}
{% set modalId = "swimDeckPlan" %}
{% set modalTitle = "Race Metrics" %}
{% set modalBody %}
<div class="swim-deck-modal__row swim-deck-modal__row--compact">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-plan-distance-label">Distance</span>
    <div class="swim-deck__field">
      <select class="form-control" aria-labelledby="sd-plan-distance-label" data-input="distance" data-st-event-options></select>
      <span class="swim-deck__field-value" aria-hidden="true" data-st="distance"></span>
    </div>
  </div>
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-plan-stroke-label">Stroke</span>
    {{ strokeSelect('aria-labelledby="sd-plan-stroke-label"', 'data-input="stroke"') }}
  </div>
</div>
<div class="form-group">
  <span class="swim-deck-modal__label" id="sd-plan-course-label">Course</span>
  <div class="swim-seg" role="group" aria-labelledby="sd-plan-course-label" data-control="course">
    {% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="false">{{ c }}</button>{% endfor %}
  </div>
</div>
{% endset %}
{% set modalFooter %}
<button type="button" class="btn btn-md btn-primary js-modal-close">Done</button>
{% endset %}
{% include "components/modal.njk" %}

{# Convert a Time's controls (Calculators) as a modal: the event and its
   time or pace (per 100). The same settings as the section's own controls, bound the
   same way, so time and pace update each other and the section at once
   (swim-tools-v2.js). No trigger yet: open it with
   data-modal-target="#swimDeckConv". #}
{% set modalId = "swimDeckConv" %}
{% set modalTitle = "Convert a Time" %}
{% set modalBody %}
<div class="swim-deck-modal__row swim-deck-modal__row--compact">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-convm-distance-label">Distance</span>
    <div class="swim-deck__field">
      <select class="form-control" aria-labelledby="sd-convm-distance-label" data-conv-input="distance" data-st-conv-options></select>
      <span class="swim-deck__field-value" aria-hidden="true" data-st="convDistance"></span>
    </div>
  </div>
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-convm-stroke-label">Stroke</span>
    {{ strokeSelect('aria-labelledby="sd-convm-stroke-label"', 'data-conv-input="stroke"') }}
  </div>
</div>
<div class="form-group">
  <span class="swim-deck-modal__label" id="sd-convm-course-label">Course</span>
  <div class="swim-seg" role="group" aria-labelledby="sd-convm-course-label" data-conv="course">
    {% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="false">{{ c }}</button>{% endfor %}
  </div>
</div>
<div class="swim-deck-modal__row swim-deck-modal__row--compact swim-convm__times">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-convm-time-label">Time</span>
    {{ timeField("sd-convm-time-label", 'data-time-conv="time"', "sm") }}
  </div>
  <span class="swim-swim__or">or</span>
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-convm-pace-label">Pace <span class="swim-swim__optional">(per 100)</span></span>
    {{ timeField("sd-convm-pace-label", 'data-time-conv="pace"', "sm", true) }}
  </div>
</div>
<span class="swim-params__hint" data-st="convHint" aria-live="polite"></span>
{% endset %}
{% set modalFooter %}
<button type="button" class="btn btn-md btn-primary js-modal-close">Done</button>
{% endset %}
{% include "components/modal.njk" %}

{# Your Races: every race, filterable by course, stroke and distance, with a
   checkbox each; Add to chart shows only the checked races on the chart it
   was opened for (data-races-target: "trend", Race History, or "pred", Race
   Time Predictions), until that chart's Clear. Opened from Your Races' gear
   (Race History) and each chart's Add races link (swim-tools-v2.js, pick). #}
{% set modalId = "swimDeckRaces" %}
{% set modalTitle = "Your Races" %}
{# Large and a fixed size, so filtering doesn't resize it (swim-tools-v2.css) #}
{% set modalSize = "lg" %}
{% set modalBody %}
<p class="swim-pick__intro" data-st="pickIntro"></p>
<div class="swim-deck-modal__row swim-deck-modal__row--compact swim-pick__filters">
  <div class="form-group">
    <span class="swim-deck-modal__label" id="sd-pick-course-label">Course</span>
    <div class="swim-seg" role="group" aria-labelledby="sd-pick-course-label" data-pick-filter="course">
      <button type="button" data-value="" aria-pressed="true">All</button>{% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="false">{{ c }}</button>{% endfor %}
    </div>
  </div>
  <div class="form-group">
    <label class="swim-deck-modal__label" for="sd-pick-stroke">Stroke</label>
    <select class="form-control swim-pick__select" id="sd-pick-stroke" data-pick-input="stroke">
      <option value="">All</option>
      {% for st in [["Free", "Free"], ["Back", "Back"], ["Breast", "Breast"], ["Fly", "Butterfly"], ["IM", "IM"]] %}<option value="{{ st[0] }}">{{ st[1] }}</option>{% endfor %}
    </select>
  </div>
  <div class="form-group">
    <label class="swim-deck-modal__label" for="sd-pick-distance">Distance</label>
    <select class="form-control swim-pick__select" id="sd-pick-distance" data-pick-input="distance"></select>
  </div>
</div>
<div class="swim-pick__bar">
  <label class="swim-pick__all"><input type="checkbox" data-pick-all> Select all shown</label>
  <span class="swim-pick__count" data-st="pickCount" aria-live="polite"></span>
</div>
<ul class="swim-pick__list" data-pick-list></ul>
{% endset %}
{% set modalFooter %}
<button type="button" class="btn btn-md btn-outline js-modal-close">Cancel</button>
<button type="button" class="swim-pred-link swim-pick__add" data-pick-add disabled>Add to chart</button>
{% endset %}
{% include "components/modal.njk" %}
{% set modalSize = "" %}
