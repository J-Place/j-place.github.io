{# The time Convert a Time (Calculators) converts: its own event and time,
   independent of Your Event. Feeds Course Conversion and Age Group
   Conversion (swim-tools-v2.js), which take your age from your profile,
   or the age group at the top of the page when we don't know it.
   The controls band of the Convert a Time panel, laid out like Your Event;
   hidden on phones, where the cards' gears open the Convert a Time modal. #}
{% from "partials/SwimToolsV2/TimeField.njk" import timeField %}
{% from "partials/SwimToolsV2/StrokeSelect.njk" import strokeSelect %}
<div class="swim-panel__band swim-panel__band--blue swim-panel__band--modal-on-mobile">
  <div class="swim-deck__context" role="group" aria-label="Time to convert, applies to every conversion">
    <div class="swim-swim__field">
      <label class="swim-swim__label" for="sd-conv-distance">Distance</label>
      <div class="swim-deck__field">
        <select class="form-control" id="sd-conv-distance" data-conv-input="distance" data-st-conv-options>
          {% for d in [50, 100, 200, 500, 1000, 1650] %}<option value="{{ d }}"{{ ' selected' if d == 200 }}>{{ d }}</option>{% endfor %}
        </select>
        <span class="swim-deck__field-value" aria-hidden="true" data-st="convDistance">200</span>
      </div>
    </div>
    <div class="swim-swim__field">
      <span class="swim-swim__label" id="sd-conv-stroke-label">Stroke</span>
      {{ strokeSelect('aria-labelledby="sd-conv-stroke-label"', 'data-conv-input="stroke"') }}
    </div>
    <div class="swim-swim__field">
      <span class="swim-swim__label" id="sd-conv-course-label">Course</span>
      <div class="swim-seg" role="group" aria-labelledby="sd-conv-course-label" data-conv="course">
        {% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ c }}</button>{% endfor %}
      </div>
    </div>
    {# Time or pace (per 100): changing either updates the other; the one
       changed last is what Course Conversion shows, as event times or as
       paces per course (swim-tools-v2.js) #}
    <div class="swim-swim__field">
      <span class="swim-swim__label" id="sd-conv-time-label">Time</span>
      {{ timeField("sd-conv-time-label", 'data-time-conv="time"', "xs") }}
    </div>
    <span class="swim-swim__or">or</span>
    <div class="swim-swim__field">
      <span class="swim-swim__label" id="sd-conv-pace-label">Pace <span class="swim-swim__optional">(per 100)</span></span>
      {{ timeField("sd-conv-pace-label", 'data-time-conv="pace"', "xs", true) }}
    </div>
  </div>
  {# Time errors; hidden while empty #}
  <p class="swim-deck__note swim-convert__hint" data-st="convHint" aria-live="polite"></p>
</div>
