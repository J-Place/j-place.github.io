{# Course Conversion: the Convert a Time entry in each course. A time shows
   as the matching event's time: the same distance, or its yards/meters
   equivalent (500 yd and 400 m); a tile names its event when the distance
   changes, or says the course has no such event. A pace shows as the pace
   per 100 in each course. Filled by swim-tools-v2.js. #}
{% from "partials/SwimToolsV2/SectionGear.njk" import sectionGear %}
<article class="swim-card" id="course-conversion">
  <header class="swim-card__header">
    <div class="swim-card__heading">
      <h3 class="swim-card__title">Course Conversion</h3>
      <p class="swim-card__sub" data-st="courseConvSubtitle"></p>
    </div>
    {{ sectionGear("swimDeckConv", "Convert a Time") }}
  </header>
  <div class="swim-tiles swim-tiles--courses">
    {% for c in courses %}
    <div class="swim-tile">
      <span class="swim-tile__course">{{ c }}</span>
      <span class="swim-tile__time" data-st="courseConv{{ c }}"></span>
      <span class="swim-tile__event" data-st="courseConvEvent{{ c }}"></span>
    </div>
    {% endfor %}
  </div>
</article>
