{% set currentUser = swimmers[swimmerId] if swimmerId else null %}
{% set swimmer = currentUser %}
<!DOCTYPE html>
<!--[if IE 9]><html lang="en" class="ie9 no-js"><![endif]-->
<!--[if !IE]><!-->
<html lang="en">
<!--<![endif]-->
<head>
  <title>{{ title if title else "U.S. Masters Swimming" }}</title>
  {% include "partials/head-meta.njk" %}
  {% include "partials/head-js.njk" %}
  {% include "partials/head-css.njk" %}
  {% block pageCSS %}{% endblock %}
  <link rel="stylesheet" href="https://www.usms.org/styles/print.min.css">
  <link rel="stylesheet" href="https://www.usms.org/styles/rteMasters.min.css">
  <link rel="stylesheet" href="/css/Common/ad.css">
  <link rel="stylesheet" href="/css/Common/buttons.css">
  <link rel="stylesheet" href="/css/Common/form-container.css">
  <link rel="stylesheet" href="/css/Common/modal.css">
  <link rel="stylesheet" href="/css/Common/membership-renewal-ribbon.css">
  {% block localCSS %}{% endblock %}
  {% if dev.env === "dev" %}{% for name, overlay in devOverlays %}{% if permalink in overlay.pages %}<link rel="stylesheet" href="{{ overlay.css }}">{% endif %}{% endfor %}{% endif %}
  <script type="application/json" id="site-users-data">{{ { "swimmers": swimmers, "membershipTiers": membershipTiers } | dump | safe }}</script>
</head>
<body class="">
  <div id="main-container">
    <header class="header-static">
      {% include "partials/membership-renewal-ribbon.njk" %}
      {% block siteNav %}
      {% include "partials/Navigation/MegaMainMenu.njk" %}
      {% endblock %}
      {% block siteHeader %}{% endblock %}
    </header>
    <main role="main">
      {% block breadcrumb %}{% endblock %}
      {% block pageHeader %}{% endblock %}
      {% block content %}{% endblock %}
    </main>
  </div>
  {% block siteFooter %}
  {% include "partials/Navigation/Footer.njk" %}
  {% endblock %}
  {% block megamenuJS %}
  <script src="/js/megamenu.js" defer></script>
  {% endblock %}
  {% block pageJS %}{% endblock %}
  <script src="/js/current-user.js"></script>
  {% if dev.env === "dev" %}
  {% for name, overlay in devOverlays %}{% if permalink in overlay.pages %}
  {% if overlay.defer === false %}<script src="{{ overlay.js }}"></script>{% else %}<script src="{{ overlay.js }}" defer></script>{% endif %}
  {% endif %}{% endfor %}
  {% endif %}
</body>
</html>
