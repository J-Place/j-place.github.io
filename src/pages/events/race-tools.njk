---
permalink: /events/race-tools/index.html
title: Race Tools | U.S. Masters Swimming
pageTitle: Race Tools
toolsPage: race
# Default persona (Jay Place); ?user=<users.json key> switches swimmer, and
# with it the race history and age (race-tools.js)
swimmerId: KT2JH
breadcrumbs:
  - url: "/home"
    label: "Home"
  - url: "/events/"
    label: "Events"
courses: [SCY, SCM, LCM]
---
{% extends "layouts/base.njk" %}
{% block breadcrumb %}{% include "partials/Common/Breadcrumb.njk" %}{% endblock %}
{% from "partials/RaceTools/StrokeSelect.njk" import strokeSelect %}
{% block pageCSS %}
{# Breadcrumbs as the article5 pages': a white bar, grey links, "/" between #}
<link href="/css/Common/Breadcrumb.css" rel="stylesheet">
<link rel="stylesheet" href="/css/pages/race-tools.css">
{% endblock %}
{% block pageJS %}
{# The FLOG client, for Add to Log (Race Splits' link, hidden for now) #}
<script src="/js/flog/flog-api.js" defer></script>
<script src="/js/race-tools.js" defer></script>
{% endblock %}
{% block content %}
{# Race Tools (again since 2026-10-29; Race Analysis on 2026-10-28; Swim Tools v2 until 2026-10-27, when Training Metrics moved
   to Training Tools, swim-tools-training.njk): v2 of
   /fitness-and-training/swim-tools/. One shared swimmer context drives every
   tool, and each tool's inputs live in an editor modal. Values are filled
   in by race-tools.js, which runs both pages. #}
<section class="section section-full swim-deck-page">
  <div class="usms-container p-tb-10 swim-deck">
    <header class="swim-deck__head">
      <div>
        <h1 class="swim-deck__title">Race Tools</h1>
        {# Commented out 2026-10-15: the intro under the title ("Welcome back,
           Jay…" when logged in, as on v4; race-tools.js still sets it,
           harmlessly, with nothing to fill). Its CSS is commented out too.
        <p class="swim-deck__intro" data-st="greeting">Manage your races, times and training, all in one place.</p>
        #}
      </div>
    </header>

    {# No toolbar since 2026-10-29: who the tools are for is in the Race
       Metrics controls band #}

    <div class="swim-deck__sections" id="swim-deck-sections">
      <section class="swim-deck__section" id="race-planning" aria-labelledby="race-planning-title">
        {# For screen readers only (since 2026-10-27) #}
        <h2 class="swim-deck__eyebrow visually-hidden" id="race-planning-title">Race metrics</h2>
        {# One bordered panel: Your Event on light blue, then the tools on white #}
        <div class="swim-panel">
          <div class="swim-panel__band swim-panel__band--blue">
            <div class="swim-deck__band-row">
            {# Who the tools are for (your name, age group and category, or a
               guest's Age Group and Competition Category): at the right of
               the controls; first, above them, on phones (since 2026-10-29) #}
            <div class="swim-deck__band-who">
              {% include "partials/RaceTools/Who.njk" %}
            </div>
            {# Your Event: labels above each control, like Your Swim. Hidden
               on phones: the cards' gears open the same controls in the
               Race Metrics modal #}
            <div class="swim-deck__context" role="group" aria-label="Your event, applies to every tool">
              {# Options follow course and stroke (race-tools.js). Also the Race
                 Time Predictor's marked event. #}
              <div class="swim-swim__field">
                <label class="swim-swim__label" for="sd-distance">Distance</label>
                <div class="swim-deck__field">
                  <select class="form-control" id="sd-distance" data-input="distance" data-st-event-options>
                    {% for d in [50, 100, 200, 500, 1000, 1650] %}<option value="{{ d }}"{{ ' selected' if d == 200 }}>{{ d }}</option>{% endfor %}
                  </select>
                  {# The blue pill over the select's own (hidden) value, so the arrow
                     can sit outside it #}
                  <span class="swim-deck__field-value" aria-hidden="true" data-st="distance">200</span>
                </div>
              </div>
              <div class="swim-swim__field">
                <span class="swim-swim__label" id="sd-event-stroke-label">Stroke</span>
                {{ strokeSelect('aria-labelledby="sd-event-stroke-label"', 'data-input="stroke"') }}
              </div>
              <div class="swim-swim__field">
                <span class="swim-swim__label" id="sd-event-course-label">Course</span>
                <div class="swim-seg" role="group" aria-labelledby="sd-event-course-label" data-control="course">
                  {% for c in courses %}<button type="button" data-value="{{ c }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ c }}</button>{% endfor %}
                </div>
              </div>
              {# Its Goal (and Set this goal beside it) was removed 2026-10-27:
                 the goal is set in the Race Metrics modal (a card's gear, or
                 Race Goal's Set this goal), or by dragging its dot #}
            </div>
            </div>
          </div>
          {# The tools, on white #}
          <div class="swim-panel__band">
            {# The two columns end level: balanceRacePlanning (race-tools.js) #}
            <div class="swim-deck__grid swim-deck__grid--8-4 swim-deck__grid--balance">
              {# Time Predictions (hidden for now), Race History, Your Races,
                 then Set a Race Goal (members; Your Races moved above it
                 2026-10-27) #}
              <div class="swim-deck__cell swim-deck__cell--stack">
                {% include "partials/RaceTools/RacePredictor.njk" %}
                {% include "partials/RaceTools/RaceTrend.njk" %}
                {% include "partials/RaceTools/RaceHistory.njk" %}
                {% include "partials/RaceTools/RaceGoal.njk" %}
              </div>
              {# Rank and Tier, the age-up or comeback card (members), Your
                 Strengths and Race Splits (hidden for now; Your Strengths
                 in its place since 2026-10-27), then Age Group Rank, beside
                 Set a Race Goal (Rank and Tier moved up from the bottom and
                 Age Group Rank down from the top 2026-10-28) #}
              <div class="swim-deck__cell swim-deck__cell--stack">
                {% include "partials/RaceTools/RankTier.njk" %}
                {% include "partials/RaceTools/AgeUp.njk" %}
                {% include "partials/RaceTools/Strengths.njk" %}
                {% include "partials/RaceTools/RaceSplits.njk" %}
                {% include "partials/RaceTools/AgeRank.njk" %}
              </div>
              {# Retired 2026-10-14: Top 10 by Decade (TopTens.njk, kept for reuse).
                 To restore, include it here again in a full-width cell, and Rank
                 and Tier's link to it (RankTier.njk). #}
            </div>
          </div>
        </div>
      </section>

      {# Calculators (since 2026-10-25): Time Conversions, under its own
         heading. Pace and calories (the Your Swim calculator) was here too
         until 2026-10-27, when it moved to Training Tools. #}
      <section class="swim-deck__section" id="calculators" aria-labelledby="calculators-title">
        {# For screen readers only (since 2026-10-27); Convert a time is the
           heading shown #}
        <h2 class="swim-deck__eyebrow visually-hidden" id="calculators-title">Calculators</h2>
        <h3 class="swim-deck__subhead" id="convert-time-title">Convert a time</h3>
        {# One bordered panel, like Race Metrics: the time to convert on
           light blue, then the conversions on white #}
        <div class="swim-panel swim-convert" id="convert-time" aria-labelledby="convert-time-title">
          {% include "partials/RaceTools/ConvertTime.njk" %}
          <div class="swim-panel__band">
            <div class="swim-deck__grid swim-deck__grid--5-7">
              {# Course Conversion (Age Group Rank moved to Race Metrics
                 2026-10-15) #}
              <div class="swim-deck__cell">{% include "partials/RaceTools/CourseConversion.njk" %}</div>
              <div class="swim-deck__cell">{% include "partials/RaceTools/AgeConversion.njk" %}</div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <p class="swim-deck__disclaimer">Results are estimates. Race history is from USMS meet results and Top 10 times from USMS Top 10 lists; age-group averages are sample data.</p>
  </div>
</section>
{% include "partials/RaceTools/Editors.njk" %}
{% endblock %}
