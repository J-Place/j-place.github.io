{% extends "layouts/base.njk" %}
{% block breadcrumb %}{% include "partials/Common/Breadcrumb.njk" %}{% endblock %}
{% block pageCSS %}
<link href="/css/Common/Breadcrumb.css" rel="stylesheet">
<link rel="stylesheet" href="/css/pages/race-tools.css">
{% endblock %}
{% block pageJS %}
<script src="/js/race-tools.js" defer></script>
{% endblock %}
{% block content %}
{# Training Tools (since 2026-10-27): Training Metrics and Pace and calories, moved from Race Tools
   (race-tools.njk), whose script, styles, toolbar and modals it shares.
   Your races come along unseen: Training Effect's threshold pace is worked
   out from them. #}
<section class="section section-full swim-deck-page">
  <div class="usms-container p-tb-10 swim-deck">
    <header class="swim-deck__head">
      <div>
        <h1 class="swim-deck__title">Training Tools</h1>
        <a class="swim-deck__other" href="/events/race-tools/">Race Tools <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </header>

    {# Toolbar: the page tabs, and who the tools are for. Above the sections,
       not beside the first one's heading: Training Metrics' heading is for
       screen readers only (since 2026-10-28). #}
    <div class="swim-deck__toolbar swim-deck__toolbar--no-headings">
      <div class="swim-deck__head-side">
        {% include "partials/RaceTools/Who.njk" %}
      </div>
    </div>

    {% include "partials/RaceTools/RaceData.njk" %}
    <div class="swim-deck__sections" id="swim-deck-sections">
      <section class="swim-deck__section" id="training-metrics" aria-labelledby="training-metrics-title">
        {# For screen readers only (since 2026-10-28) #}
        <h2 class="swim-deck__eyebrow visually-hidden" id="training-metrics-title">Training metrics</h2>
        {% include "partials/RaceTools/Training.njk" %}
      </section>
      {# Pace and calories (the Your Swim calculator; on Race Tools'
         Calculators until 2026-10-27) #}
      <section class="swim-deck__section" id="pace-calories" aria-labelledby="your-swim-title">
        <h2 class="swim-deck__eyebrow" id="your-swim-title">Pace and calories</h2>
        {% include "partials/RaceTools/YourSwim.njk" %}
      </section>
    </div>

    <p class="swim-deck__disclaimer">Results are estimates. Training Effect's threshold pace comes from your USMS meet results; age-group times are sample data.</p>
  </div>
</section>
{% include "partials/RaceTools/Editors.njk" %}
{% endblock %}
