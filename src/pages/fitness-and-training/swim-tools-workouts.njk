{% extends "layouts/article.njk" %}
{# Workout Generator, a view of the Swim Tools app (~/dev/usms/swim-tools).
   This page plays Sitecore's part: the chrome and a mount point. The app's
   embed bundle (src/js/swim-tools/, synced by its npm run sync:eleventy)
   renders the view into the div; src/js/swim-tools-host.js works out the
   persona and which data source to use, then mounts it. #}
{% block pageCSS %}
<link href="/css/Common/Breadcrumb.css" rel="stylesheet">
<link rel="stylesheet" href="/css/pages/swim-tools-host.css">
<link rel="stylesheet" href="/js/swim-tools/swim-tools.css">
{% endblock %}
{% block pageJS %}
<script src="/js/swim-tools/swim-tools.js" defer></script>
<script src="/js/swim-tools-host.js" defer></script>
{% endblock %}
{% block content %}
<section class="section section-full swim-tools-host">
  <div class="usms-container p-tb-10">
    <h1 class="visually-hidden">Workout Generator</h1>
    <div data-usms-component="SwimTools" data-view="workouts" data-default-persona="{{ swimmerId }}"></div>
  </div>
</section>
{% endblock %}
