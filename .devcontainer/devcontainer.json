// Eleventy prototype dev container: see ~/dev/usms/swim-tools/docs/dev-container.md.
// It can reach this repo only, with production/ (the Sitecore checkout, whose
// config files hold credentials) covered by an empty volume, so it's empty
// inside. Run the visual tests, vendor:refresh, top-times:scrape and the
// production monitor from the Mac: they need www.usms.org or the Mac's
// screenshots.
{
  "name": "eleventy",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Puerto_Rico}",
      "CLAUDE_CODE_VERSION": "latest",
      "PLAYWRIGHT_VERSION": "1.62.1"
    }
  },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "node",

  "workspaceMount": "source=${localWorkspaceFolder},target=/usms/eleventy,type=bind,consistency=delegated",
  "workspaceFolder": "/usms/eleventy",
  "mounts": [
    // The cover: an empty volume over production/
    "source=eleventy-production-cover-${devcontainerId},target=/usms/eleventy/production,type=volume",
    // Linux builds of node_modules, kept apart from the Mac's
    "source=eleventy-node-modules-${devcontainerId},target=/usms/eleventy/node_modules,type=volume",
    // Generated by predev, for the same reason
    "source=eleventy-top-times-${devcontainerId},target=/usms/eleventy/src/data/top-times-generated,type=volume",
    // Claude Code's sign-in and settings, shared by the USMS repos' containers
    "source=claude-code-config-usms,target=/home/node/.claude,type=volume",
    "source=eleventy-history-${devcontainerId},target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    // puppeteer would download a browser on install; the image has Playwright's
    "PUPPETEER_SKIP_DOWNLOAD": "true"
  },

  "postCreateCommand": "npm ci",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand",
  "forwardPorts": [8080],

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint"]
    }
  }
}
