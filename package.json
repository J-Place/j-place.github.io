{
  "name": "usms-github-jplace-eleventy",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve --port=8080",
    "build:css": "node scripts/build-css.js",
    "build:css:common": "node scripts/build-css.js common",
    "build:snapshot": "node scripts/snapshot.js",
    "deploy:snapshot": "node scripts/snapshot.js --deploy",
    "deploy:prototype": "npm run build && netlify deploy --dir=_site --prod",
    "lint": "eslint src/js/",
    "test:visual": "node scripts/run-test-visual.js",
    "test:visual:triage": "node scripts/triage-visual-regression.js",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "publish:visual-report": "node scripts/publish-visual-report.js",
    "monitor:prod": "playwright test --config=playwright.production-monitor.config.js",
    "monitor:prod:update": "playwright test --config=playwright.production-monitor.config.js --update-snapshots",
    "monitor:prod:report": "playwright show-report production-monitor-report --port 9324",
    "publish:production-monitor-report": "node scripts/publish-production-monitor-report.js",
    "detect:production-deploy": "node scripts/detect-production-deploy.js",
    "vendor:discover": "node scripts/discover-vendor-urls.js",
    "vendor:migrate": "node scripts/migrate-vendor-refs.js",
    "vendor:refresh": "node scripts/vendor-refresh.js",
    "detect:flaky-regions": "node scripts/detect-flaky-regions.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.10",
    "postcss-calc": "^10.1.1",
    "postcss-custom-media": "^12.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "puppeteer": "^24.42.0"
  }
}
