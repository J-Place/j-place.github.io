{
  "name": "usms-github-jplace-eleventy",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve --port=8080",
    "build:css": "node scripts/build-css.js",
    "build:css:common": "node scripts/build-css.js common",
    "build:snapshot": "node scripts/snapshot.js",
    "deploy:snapshot": "node scripts/snapshot.js --deploy",
    "deploy:prototype": "npm run build && netlify deploy --dir=_site --prod",
    "lint": "eslint src/js/",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "publish:visual-report": "node scripts/publish-visual-report.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "postcss": "^8.5.10",
    "postcss-calc": "^10.1.1",
    "postcss-custom-media": "^12.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "puppeteer": "^24.42.0"
  }
}
